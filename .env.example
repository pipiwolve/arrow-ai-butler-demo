# 箭牌智家 AI 助手 · 本地编排服务（端口 8898）
PORT=8898

# DuMate Agent API 凭证（勿提交）
DUMATE_API_KEY=<你的 API Key>
DUMATE_BASE_URL=https://api.dumate.cn/api/v1

# ---- IoT 网关 ----
# IOT_MODE：mock = 起本地网关（iot/mock-gateway.mjs）；real = 直接打箭牌环境
IOT_MODE=mock
IOT_PORT=18899
IOT_TOKEN=demo-token

# ---- 两套设备清单，用 IOT_FIXTURE 选 ----
# demo = iot/devices.json（11 台，含 room 与在线态覆盖，演示用）
# real = iot/devices.real.json（真实环境快照，由 node iot/fetch-devices.mjs 生成，联调用）
# 也可以用命令行覆盖，不必改这个文件。真实网关下两种组合差别很大：
#   IOT_MODE=real IOT_FIXTURE=demo node server.mjs   请求发得出去，闸门用演示在线态
#   IOT_MODE=real IOT_FIXTURE=real node server.mjs   闸门用真实在线态，11 台全离线，发不出去
# IOT_FIXTURE=demo

# ---- 走真实环境时填这两行 ----
# IOT_BASE_URL=https://api-uatiot.arrowgroup.com.cn
# IOT_TOKEN=<箭牌给的 bearer token>

# ---- 语音输入（按住说话）----
# 百度短语音识别极速版，文档 https://cloud.baidu.com/doc/SPEECH/s/4lbxdz34z
# 从控制台「语音技术」拿 IAM 新式 API Key（形如 bce-v3/ALTAK-.../...），直接做 Bearer 用，
# 不用去 oauth/2.0/token 换 access_token。不配这项时语音按钮会报「未配置 ASR Key」，
# 文字对话不受影响。80001 是极速版输入法模型。
# ASR_API_KEY=bce-v3/ALTAK-xxxxxxxxxxxx/yyyyyyyyyyyyyyyy
# ASR_DEV_PID=80001
